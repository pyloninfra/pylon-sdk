{
  "name": "@sponsor-kit/sdk",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/react.ts --format esm --dts",
    "dev": "tsup src/index.ts src/react.ts --format esm --dts --watch",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sponsor-kit/common": "workspace:*",
    "viem": "^2.21.0"
  },
  "peerDependencies": { "react": ">=18.0.0" },
  "devDependencies": {
    "tsup": "^8.1.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0",
    "@types/react": "^18.3.3"
  }
}
